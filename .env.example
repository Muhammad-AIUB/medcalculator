# ============================================================
# Database — Neon PostgreSQL
# ============================================================
# Pooler URL (used at runtime by the app — pgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&connection_limit=1

# Direct URL (used by Prisma CLI for migrations — no pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# ============================================================
# Backend
# ============================================================
NODE_ENV=development
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5001

# ============================================================
# Frontend
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:5001

# ============================================================
# Redis (optional — used for caching, not required to start)
# ============================================================
REDIS_URL=redis://localhost:6379
