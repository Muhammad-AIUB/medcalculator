generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CalculatorCategory {
  RENAL
  LIVER
  CARDIAC
  NUTRITION
  OBSTETRIC
  CRITICAL_CARE
  HEMATOLOGY
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @unique @default(uuid()) @db.Uuid
  deviceInfo  String?
  preferences Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  history   CalculationHistory[]
  favorites Favorite[]
  auditLogs AuditLog[]

  @@map("users")
}

model CalculationHistory {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String?             @db.Uuid
  calculatorId    String
  calculatorName  String
  category        CalculatorCategory?
  inputs          Json
  outputs         Json
  units           Json?
  formula         String?
  sessionId       String
  ipAddress       String?
  createdAt       DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([calculatorId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("calculation_history")
}

model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  calculatorId String
  pinnedOrder  Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calculatorId])
  @@index([userId])
  @@map("favorites")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  duration   Int?
  statusCode Int?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
