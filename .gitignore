# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
.next/
build/
out/
# tsc --noEmit rewrites this on every type-check, so a tracked copy shows up
# dirty in every diff and conflicts on every merge.
*.tsbuildinfo

# The Capacitor Android project is committed, not regenerated. It carries state
# that `npx cap add android` would silently reset: the Play versionCode, the
# release R8/shrinkResources config, and the target API level Play enforces.
# Its own android/.gitignore keeps build output and local.properties out.

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

