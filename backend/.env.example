# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&connection_limit=1
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Security
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars-change-this
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5001

# Redis, optional
REDIS_URL=redis://localhost:6379

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info
